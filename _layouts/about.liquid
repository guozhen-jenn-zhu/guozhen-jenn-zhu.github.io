---
layout: default
---
<div class="post home-layout" id="top">
  {% include home_sidebar.liquid %}

  <main class="home-main">
    <!-- About -->
    <section id="about" class="home-intro clearfix">{{ content }}</section>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <section id="news" class="home-section">
        <h2 class="home-section__title">
          <a href="{{ '/news/' | relative_url }}">News</a>
        </h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <section class="home-section">
        <h2 class="home-section__title">
          <a href="{{ '/blog/' | relative_url }}">latest posts</a>
        </h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section id="publications" class="home-section">
        <h2 class="home-section__title">
          <a href="{{ '/publications/' | relative_url }}">Selected publications</a>
        </h2>
        {% include selected_papers.liquid %}
        <p class="home-viewall">
          <a href="{{ '/publications/' | relative_url }}">All publications &rarr;</a>
        </p>
      </section>
    {% endif %}

    <!-- Patents -->
    {% if page.patents and page.patents.enabled %}
      <section id="patents" class="home-section">
        <h2 class="home-section__title">
          <a href="{{ '/patents/' | relative_url }}">Patents</a>
        </h2>
        {% include selected_patents.liquid %}
        <p class="home-viewall">
          <a href="{{ '/patents/' | relative_url }}">All patents &rarr;</a>
        </p>
      </section>
    {% endif %}

    <!-- Industry Impact -->
    {% if page.industry_impact and page.industry_impact.enabled %}
      <section class="home-section">
        <h2 class="home-section__title">Industry Impact</h2>
        <p class="home-section__lead">Technology deployed worldwide across multiple sectors:</p>
        {% include industry_impact.liquid %}
      </section>
    {% endif %}

    <!-- Research Services -->
    {% if page.research_services and page.research_services.enabled %}
      <section class="home-section">
        <h2 class="home-section__title">Research Services</h2>
        <p class="home-section__lead">Reviewer for:</p>
        {% include research_services.liquid %}
      </section>
    {% endif %}

    {% if site.contact_note %}
      <p class="home-contact-note">{{ site.contact_note }}</p>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </main>
</div>
